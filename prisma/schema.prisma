generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int               @id @default(autoincrement())
  username             String            @unique
  email                String            @unique
  password             String?
  authProvider         String            @default("credentials")
  role                 Role?
  isPro                Boolean           @default(false)
  stripeCustomerId     String?           @unique
  firstName            String?
  lastName             String?
  gender               String?
  phoneNo              String?
  userBio              String?
  userAbout            Json?
  profession           String?
  website              String?
  address              String?
  city                 String?
  state                String?
  country              String?
  postalCode           String?
  userImage            String?
  userImagePublicId    String?
  profileImage         String?
  profileImagePublicId String?
  resume               String?
  resumePublicId       String?
  skills               String[]
  resetPasswordToken   String?           @unique
  resetPasswordExpires DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  chatsReceived        Chats[]           @relation("ReceiverChats")
  chatsSent            Chats[]           @relation("SenderChats")
  company              Company?
  sentInvitations      CompanyEmployee[] @relation("CompanyInviter")
  companyMemberships   CompanyEmployee[] @relation("CompanyMember")
  educations           Education[]
  experiences          Experience[]
  following            Follow[]          @relation("UserFollowing")
  followers            Follow[]          @relation("UserFollowers")
  postedJobs           Job[]             @relation("PostedJobs")
  jobApplications      JobApplication[]
  messages             Message[]
  profileViewsReceived ProfileView[]     @relation("ProfileUserViews")
  profileViewsGiven    ProfileView[]     @relation("ViewerUserViews")
  projects             Project[]
  savedJobs            SavedJob[]
  subscription         Subscription?
}

model Company {
  id                       Int               @id @default(autoincrement())
  companyName              String            @unique
  companyImage             String?
  companyImagePublicId     String?
  companyBackImage         String?
  companyBackImagePublicId String?
  companyAddress           String
  companyCity              String
  companyState             String
  companyCountry           String
  companyWebsite           String?
  companyAbout             String
  companyBio               String
  companyTotalEmployees    String
  companyIsVerified        Boolean           @default(false)
  userId                   Int               @unique
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employees                CompanyEmployee[]
  jobs                     Job[]

  @@index([companyName(ops: raw("gin_trgm_ops"))], map: "company_name_trgm_idx", type: Gin)
}

model CompanyEmployee {
  id          Int                   @id @default(autoincrement())
  companyId   Int
  userId      Int
  invitedById Int?
  role        CompanyEmployeeRole   @default(RECRUITER)
  status      CompanyEmployeeStatus @default(PENDING)
  joinedAt    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User?                 @relation("CompanyInviter", fields: [invitedById], references: [id])
  user        User                  @relation("CompanyMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([companyId, role])
  @@index([companyId, status])
}

model Job {
  id              Int              @id @default(autoincrement())
  jobTitle        String
  jobDesc         String
  experience      String
  salary          String
  vacancies       String
  city            String
  state           String
  country         String
  type            String
  mode            String
  isEasyApply     Boolean          @default(false)
  applyLink       String?
  skills          String[]
  questions       Json?
  status          String           @default("ACTIVE")
  expiresAt       DateTime?
  userId          Int
  companyId       Int
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User             @relation("PostedJobs", fields: [userId], references: [id], onDelete: Cascade)
  jobApplications JobApplication[]
  savedBy         SavedJob[]

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([city(ops: raw("gin_trgm_ops"))], map: "job_city_trgm_idx", type: Gin)
  @@index([companyId], map: "job_company_id_idx")
  @@index([jobDesc(ops: raw("gin_trgm_ops"))], map: "job_desc_trgm_idx", type: Gin)
  @@index([status], map: "job_status_idx")
  @@index([jobTitle(ops: raw("gin_trgm_ops"))], map: "job_title_trgm_idx", type: Gin)
}

model SavedJob {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobId     Int
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model JobApplication {
  id                      Int                        @id @default(autoincrement())
  userId                  Int
  jobId                   Int
  candidateEmail          String
  candidateMobile         String
  candidateResume         String
  candidateResumePublicId String?
  questionAndAnswers      Json?
  status                  ApplicationStatus          @default(APPLIED)
  appliedAt               DateTime                   @default(now())
  viewedAt                DateTime?
  shortlistedAt           DateTime?
  interviewScheduledAt    DateTime?
  interviewedAt           DateTime?
  hiredAt                 DateTime?
  rejectedAt              DateTime?
  withdrawnAt             DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  statusHistory           ApplicationStatusHistory[]
  job                     Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@index([jobId, status])
  @@index([status, createdAt])
}

model ApplicationStatusHistory {
  id             Int               @id @default(autoincrement())
  applicationId  Int
  status         ApplicationStatus
  createdAt      DateTime          @default(now())
  jobApplication JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ProfileView {
  id            Int      @id @default(autoincrement())
  profileUserId Int
  viewerUserId  Int?
  createdAt     DateTime @default(now())
  profileUser   User     @relation("ProfileUserViews", fields: [profileUserId], references: [id], onDelete: Cascade)
  viewer        User?    @relation("ViewerUserViews", fields: [viewerUserId], references: [id])

  @@unique([profileUserId, viewerUserId])
  @@index([profileUserId])
  @@index([viewerUserId])
}

model Education {
  id            Int      @id @default(autoincrement())
  instituteName String
  degree        String
  fieldOfStudy  String
  startDate     String
  endDate       String
  percentage    String
  userId        Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Experience {
  id          Int      @id @default(autoincrement())
  companyName String
  position    String
  startDate   String
  endDate     String
  description String?
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id               Int      @id @default(autoincrement())
  proName          String
  proLink          String
  proImage         String
  proImagePublicId String?
  proDesc          String
  userId           Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Chats {
  id            Int       @id @default(autoincrement())
  senderId      Int
  receiverId    Int
  lastMessage   String?
  lastMessageAt DateTime?
  isSeen        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  receiver      User      @relation("ReceiverChats", fields: [receiverId], references: [id], onDelete: Cascade)
  sender        User      @relation("SenderChats", fields: [senderId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([lastMessageAt])
}

model Message {
  id            Int      @id @default(autoincrement())
  chatId        Int
  senderId      Int
  text          String?
  image         String?
  imagePublicId String?
  file          String?
  fileName      String?
  fileType      String?
  isSeen        Boolean  @default(false)
  isDeleted     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  chat          Chats    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender        User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@index([isSeen])
}

model Subscription {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  subscriptionStatus     String
  planName               String?
  billingInterval        String?
  amount                 Int?
  cancelAtPeriodEnd      Boolean   @default(false)
  canceledAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CANDIDATE
  RECRUITER
  ORGANIZATION
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  HIRED
  REJECTED
  WITHDRAWN
}

enum CompanyEmployeeRole {
  OWNER
  ADMIN
  HR
  RECRUITER
}

enum CompanyEmployeeStatus {
  PENDING
  ACCEPTED
  REJECTED
  LEFT
}
